# ==============================
# Fool's Playground
# Git Ignore File
# ==============================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Environment / Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build / generated files
dist/
build/
coverage/
.cache/
tmp/
temp/

# Docker
docker-data/
docker-volumes/

# CTF runtime / local data
ctfd-data/
uploads/
instance/

# Test artifacts
test-output/
screenshots-temp/

# Local challenge secrets
secrets/
private/
flags-private/

# OS / temporary files
*.tmp
*.temp

# Large forensic/network artifacts that should not be committed
*.pcapng
*.pcap
*.raw
*.img
*.dd

# Local backups
*.bak
*.backup

# Player-facing FP-05 artifact
!challenges/FP-05-The-Silent-Network/artifact/silent-network.pcapng

