# Fool's Playground standalone CTFd configuration.
# Copy this template to .env.standalone and replace the placeholders.

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
CTFD_BIND_ADDRESS=127.0.0.1
CTFD_PORT=8000

MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=ctfd
MYSQL_USER=ctfd
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
